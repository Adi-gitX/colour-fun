# Atlas — copy to .env and fill in. Never commit .env.

# Gemini key for the AI finder. Used by `npm run embed` (build-time, never shipped) and, when
# VITE_GEMINI_API_KEY is set, by the browser directly (development only — VITE_ vars are public).
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Models. gemini-flash-latest answers; gemini-embedding-001 embeds the catalogue and each request.
VITE_GEMINI_MODEL=gemini-flash-latest
VITE_GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=256

# Production: leave VITE_GEMINI_API_KEY empty and point the app at the registry API, which holds
# the key server-side and does the same retrieval + ranking.
VITE_ATLAS_API_URL=
VITE_ATLAS_API_KEY=
