# Server-side only. On Vercel, set these under Project → Settings → Environment Variables.
# Nothing here is sent to the browser: the app talks to /api/find, which holds the keys.
# Every provider below has a free tier with no card; each switches on when its key is set.

# Gemini — judge fallback models, plus Google Search as the last-resort web search.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web search, 1,000 searches/month free — https://app.tavily.com
TAVILY_API_KEY=

# Web search fallback, 10M free tokens on a new key — https://jina.ai
JINA_API_KEY=

# Judge model (gpt-oss-120b), 1,000 requests/day free — https://console.groq.com/keys
GROQ_API_KEY=

# Optional judge fallback, 50 requests/day on :free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Answer cache, 500K commands/month free — https://console.upstash.com (Redis → REST API).
# Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN instead;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: questions one visitor can ask per 10 minutes.
# FIND_LIMIT_PER_10_MIN=12
