# CodeCraft API — routes Claude Code through codecraftapi.com for THIS project only.
# Copy to .env.codecraft and paste your key. Never commit .env.codecraft.
#
# Key comes from Dashboard -> API Keys (shown once, starts with cc_).
CODECRAFT_API_KEY=cc_paste_your_key_here

# Must end in /v1, not /v1/chat/completions.
CODECRAFT_BASE_URL=https://codecraftapi.com/v1

# Must exactly match an id from GET /v1/models, and must advertise the `tools`
# capability or the agent can read files but not edit them.
CODECRAFT_MODEL=claude-opus-4.8
